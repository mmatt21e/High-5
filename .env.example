# Copy to .env for local development. Production should inject these values or
# use an untracked .env.production file. `npm start` validates them before boot.

# --- Database ---
# SQLite is the only supported provider. Relative file paths resolve from
# prisma/schema.prisma. In production, put the database on durable storage.
DATABASE_URL="file:./dev.db"
# Example production volume: DATABASE_URL="file:/data/five-o.db"

# --- Auth.js ---
# Generate one with the command in README.md. If this is empty in development,
# the server creates an ephemeral process-only secret and sessions expire when
# it restarts. Production startup rejects an empty value.
AUTH_SECRET=""
# Base URL of the app (used for OAuth callbacks).
AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials.
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
# Supply both credentials and set the public flag to true, or leave all three
# values disabled/empty.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Set to "true" to show the "Continue with Google" button in the UI.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# --- Web Push (VAPID) — for "it's your turn" notifications ---
# Generate a keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_SUBJECT=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Same value as VAPID_PUBLIC_KEY, exposed to the browser:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Server ---
# Development binds to 127.0.0.1 by default. Set HOST explicitly only when you
# intend to expose the app to another interface. Production defaults to 0.0.0.0.
HOST=""
PORT="3000"
