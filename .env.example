# Copy to .env and fill in. For local dev the defaults below work as-is.

# --- Database ---
# Dev (SQLite, zero-config):
DATABASE_URL="file:./dev.db"
# Production (Postgres) — switch the provider in prisma/schema.prisma to
# "postgresql" and use a URL like:
# DATABASE_URL="postgresql://user:pass@host:5432/fiveo?schema=public"

# --- Auth.js ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="dev-secret-change-me-please-0000000000000000"
# Base URL of the app (used for OAuth callbacks).
AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Set to "true" to show the "Continue with Google" button in the UI.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# --- Server ---
PORT="3000"
