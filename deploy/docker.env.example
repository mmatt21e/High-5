# Docker Compose project isolation and local listener.
COMPOSE_PROJECT_NAME=five-o-poker
FIVEO_IMAGE_TAG=local
FIVEO_LOCAL_PORT=3000

# Generated automatically by Initialize-DockerEnv.ps1. Never commit docker.env.
AUTH_SECRET=__GENERATED_AUTH_SECRET__
AUTH_URL=http://localhost:3000

# Supply only the hostname (no scheme, port, path, or trailing slash) when the
# public address is known. Public modes construct https://PUBLIC_HOSTNAME.
PUBLIC_HOSTNAME=

# Optional Google OAuth. The public flag is embedded during the image build.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Optional web push. NEXT_PUBLIC_VAPID_PUBLIC_KEY is embedded during the build.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Used only by the Tunnel mode. Store the remotely managed tunnel token in this
# ignored file as a single line; do not put the token in docker.env.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./deploy/cloudflare-tunnel-token.txt
